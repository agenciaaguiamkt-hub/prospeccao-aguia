# Copie o conteúdo deste arquivo para dentro de uma pasta chamada
# ".streamlit" (com esse nome exato, incluindo o ponto na frente), num
# arquivo chamado "secrets.toml" - ou seja, o caminho final deve ser:
#   .streamlit/secrets.toml
#
# Isso só é necessário se você quiser rodar a interface (app.py) no seu
# computador. Para rodar na nuvem (Streamlit Community Cloud), NÃO precisa
# criar esse arquivo: você cola os mesmos valores na interface do site, em
# Settings → Secrets. Veja DEPLOY_NUVEM.md.
#
# NUNCA suba um arquivo secrets.toml com valores reais para o GitHub.

GOOGLE_PLACES_API_KEY = "cole_aqui_sua_chave_da_google_places_api"
APP_PASSWORD = "escolha_uma_senha_para_proteger_o_app"
